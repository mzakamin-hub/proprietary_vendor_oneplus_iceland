[Oplus3AMode]
    # Oplus3AMask: oplus 3A algo switch for each sensor name
    # close(0), ID0(0x1), ID1(0x2), ID2(0x4), ID3(0x8),..., all open(0xFF)
    OplusAEMask       = 0xFF;#imx06A; imx882; imx890_tele; imx858_tele; imx809; imx709;
    OplusAWBMask      = 0xFF;#imx06A; imx882; imx890_tele; imx858_tele; imx809; imx709;
    OplusAFMask       = 0xFF;#imx06A; imx882; imx890_tele; imx858_tele; imx809; imx709;
    OplusPDMask       = 0x00;#imx06A; imx890_tele; imx858_tele;
    OplusLocalAWBMask = 0x0D;#imx06A; imx882; imx890_tele; imx858_tele;
    OplusLocalColorMask = 0x00; #ID0(0x1), ID2(0x4), ID3(0x8)
    OplusAEversion    = 4;
    OplusAWBversion   = 4;
    OplusAFversion    = 4;
    OplusPDversion    = 4;

[OplusOtherCam3AMode]
    #operation mode       operation_mode       OplusAEMask        OplusAWBMask      OplusAFMask      OplusPDMask
        Mode[0]      =       0x8021;              0xFF;               0xFF;            0xFF;            0x00       #60fps video

[OplusAWBStatsSetting]
